[Unit]
Description=Diagnostico GGDP - formulario de duvidas (FastAPI)
After=network.target

[Service]
Type=simple
User=formduvidas
Group=formduvidas
WorkingDirectory=/opt/form-duvidas/app/backend
EnvironmentFile=/etc/form-duvidas/form-duvidas.env
ExecStart=/opt/form-duvidas/venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 --port ${APP_PORT} \
    --workers 2 \
    --proxy-headers --forwarded-allow-ips 127.0.0.1 \
    --no-server-header
Restart=always
RestartSec=3

# Endurecimento: o serviço só escreve no diretório do banco.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/form-duvidas
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
