# Copie para backend/.env e preencha. O .env não é versionado.

# Token para acessar /admin e exportar respostas. Gere um valor forte:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=troque-por-um-token-longo

# Documentação interativa da API (/api/docs). Em produção, deixe false.
API_DOCS=false

# Frontend e API no mesmo domínio: em produção o CORS não é necessário.
CORS_ORIGINS=
