# /etc/form-duvidas/form-duvidas.env — lido pelo systemd (form-duvidas.service)
# O instalar.sh cria este arquivo com um token gerado; edite se precisar.

# Token da área administrativa (/admin). Use 32+ caracteres aleatórios.
ADMIN_TOKEN=troque-por-um-token-longo

# Banco SQLite fora da pasta do código, para sobreviver às atualizações.
DATABASE_URL=sqlite:////var/lib/form-duvidas/respostas.db

# Porta interna do uvicorn (o Nginx faz o proxy; não exponha esta porta).
APP_PORT=8010

# Frontend e API no mesmo domínio: CORS não é necessário.
CORS_ORIGINS=

# Documentação interativa da API (/api/docs). Desligada em produção.
API_DOCS=false
